#===--------------------------------------------------------------------------------------------===#
# .clangd - 编辑器语言服务配置
#===--------------------------------------------------------------------------------------------===#
CompileFlags:
  # 构建后从 build/compile_commands.json 读取真实编译参数。
  CompilationDatabase: build
  Add:
    # 未生成编译数据库时按 C++20 解析。
    - -std=c++20
    # 未生成编译数据库时仍用 libc++。
    - -stdlib=libc++
    # 未生成编译数据库时打开 -Wall。
    - -Wall
    # 未生成编译数据库时打开 -Wextra。
    - -Wextra
    # 未生成编译数据库时警告即错误，与示例工程的编译选项一致。
    - -Werror

Diagnostics:
  # 补上 clangd 默认未开的命名与 google 检查，与同目录 .clang-tidy 一致。
  ClangTidy:
    Add:
      - readability-identifier-naming
      - google-build-using-namespace
      - google-global-names-in-headers
      - google-explicit-constructor
  # 只压制首次未构建时找不到头文件的噪音；构建后以编译数据库为准。
  Suppress:
    - pp_file_not_found
