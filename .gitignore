# Quarto 生成物与缓存
/_book/
/.quarto/
**/*.quarto_ipynb
/content/**/*.html
/content/**/*_files/

# CMake 构建产物（示例工程目录内）
/code/**/build/

# C++ 直接编译产物
*.o
*.obj
a.out

# Python 缓存与本地运行时配置
__pycache__/
*.py[cod]
.agents/skills/maintaining-python/assets/config/runtime.json

# 编辑器与操作系统临时文件
/.vscode/
/.idea/
.DS_Store
*.local

# 本地依赖与缓存目录
node_modules/
.tmp/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
coverage.xml
*.coverage

# ZCode 本地计划与临时区
/.zcode/

# 临时分析、重构报告与知识库索引（不入库）
/temp/
